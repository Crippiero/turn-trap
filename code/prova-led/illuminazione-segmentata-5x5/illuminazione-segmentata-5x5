// ==========================================

void setup() {
  Serial.begin(9600); // Inizializza il monitor seriale
  pinMode(PinButton, INPUT_PULLUP); // Imposta il pin del pulsante una volta sola

  for(int i = 0; i < NUM_STRIPS; i++) {
    strips[i].begin();
    strips[i].setBrightness(BRIGHTNESS);
    strips[i].clear();
    strips[i].show();
  }
}

void loop() {
  // 1. Leggiamo lo stato attuale del pin
  int statoPulsanteAttuale = digitalRead(PinButton);

  // 2. Controlliamo se è stato appena premuto (passaggio da HIGH a LOW)
  if (ultimoStatoPulsante == HIGH && statoPulsanteAttuale == LOW) { 
    s++; // Cambia il disegno
    delay(50); // Debounce per evitare false doppie letture
    if(s >= 6){ // Usare >= è un po' più sicuro di ==
      s = 0;
    }
  }
  
  // 3. Aggiorniamo l'ultimo stato per il prossimo ciclo
  ultimoStatoPulsante = statoPulsanteAttuale;

  // 4. Mostriamo il disegno in base alla variabile 's'
  if (s == 0) {
    Serial.println("Disegno 0");
    for(int riga = 0; riga < NUM_STRIPS; riga++) 
    {
      for(int colonna = 0; colonna < NUMPIXELS; colonna++) 
      {
        char letteraColore = disegno0[riga][colonna]; 
        uint32_t coloreReale = decodificaColore(letteraColore, riga); 
        strips[riga].setPixelColor(colonna, coloreReale);
      }
      strips[riga].show();
    }
  } 
  else if(s == 1){
    Serial.println("Disegno 1");
    for(int riga = 0; riga < NUM_STRIPS; riga++) 
    {
      for(int colonna = 0; colonna < NUMPIXELS; colonna++) 
      {
        char letteraColore = disegno1[riga][colonna]; 
        uint32_t coloreReale = decodificaColore(letteraColore, riga); 
        strips[riga].setPixelColor(colonna, coloreReale);
      }
      strips[riga].show();
    }
  }
  else if(s == 2){
    Serial.println("Disegno 2");
    for(int riga = 0; riga < NUM_STRIPS; riga++) 
    {
      for(int colonna = 0; colonna < NUMPIXELS; colonna++) 
      {
        char letteraColore = disegno2[riga][colonna]; 
        uint32_t coloreReale = decodificaColore(letteraColore, riga); 
        strips[riga].setPixelColor(colonna, coloreReale);
      }
      strips[riga].show();
    }
  }
  else if(s == 3){
    Serial.println("Disegno 3");
    for(int riga = 0; riga < NUM_STRIPS; riga++) 
    {
      for(int colonna = 0; colonna < NUMPIXELS; colonna++) 
      {
        char letteraColore = disegno3[riga][colonna]; 
        uint32_t coloreReale = decodificaColore(letteraColore, riga); 
        strips[riga].setPixelColor(colonna, coloreReale);
      }
      strips[riga].show();
    }
  }
  else if(s == 4){
    Serial.println("Disegno 4");
    for(int riga = 0; riga < NUM_STRIPS; riga++) 
    {
      for(int colonna = 0; colonna < NUMPIXELS; colonna++) 
      {
        char letteraColore = disegno4[riga][colonna]; 
        uint32_t coloreReale = decodificaColore(letteraColore, riga); 
        strips[riga].setPixelColor(colonna, coloreReale);
      }
      strips[riga].show();
    }
  }
else if(s == 5){
    Serial.println("Disegno 5");
    for(int riga = 0; riga < NUM_STRIPS; riga++) 
    {
      for(int colonna = 0; colonna < NUMPIXELS; colonna++) 
      {
        char letteraColore = disegno5[riga][colonna]; 
        uint32_t coloreReale = decodificaColore(letteraColore, riga); 
        strips[riga].setPixelColor(colonna, coloreReale);
      }
      strips[riga].show();
    }
  }
  
  // Un piccolo delay generale aiuta la stabilità del loop
  delay(10);
}
