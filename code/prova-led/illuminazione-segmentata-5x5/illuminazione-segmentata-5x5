#include <Adafruit_NeoPixel.h>

#define NUM_STRIPS 5
#define NUMPIXELS 5
#define BRIGHTNESS 100

const int PINS[NUM_STRIPS] = {3, 4, 5, 6, 7};
const int PinButton = 2; // Pin del pulsante

int ultimoStatoPulsante = HIGH; // Variabile per tracciare lo stato precedente del pulsante
int s = 0; // <--- SPOSTATA QUI! Ora è una variabile globale che mantiene il suo valore.

Adafruit_NeoPixel strips[NUM_STRIPS] = {
  Adafruit_NeoPixel(NUMPIXELS, PINS[0], NEO_GRB + NEO_KHZ800),
  Adafruit_NeoPixel(NUMPIXELS, PINS[1], NEO_GRB + NEO_KHZ800),
  Adafruit_NeoPixel(NUMPIXELS, PINS[2], NEO_GRB + NEO_KHZ800),
  Adafruit_NeoPixel(NUMPIXELS, PINS[3], NEO_GRB + NEO_KHZ800),
  Adafruit_NeoPixel(NUMPIXELS, PINS[4], NEO_GRB + NEO_KHZ800)
};

// %--------------------------------------------------------------%
// --% Funzione che "traduce" le lettere nei colori di NeoPixel %--
// %--------------------------------------------------------------%

uint32_t decodificaColore(char lettera, int indiceStriscia) {
  switch(lettera) {
    case 'R': 
      return strips[indiceStriscia].Color(255, 0, 0);      // Rosso pieno
    case 'W': 
      return strips[indiceStriscia].Color(255, 255, 255);  // Bianco
    case 'B': 
      return strips[indiceStriscia].Color(0, 0, 50);       // Blu scuro
    case 'G': 
      return strips[indiceStriscia].Color(255, 180, 0);    // Giallo
    case 'V': 
      return strips[indiceStriscia].Color(0, 255, 0);    // verde
    case 'N': 
      return strips[indiceStriscia].Color(0, 0, 0);        // Nero / Spento
    default:  
      return strips[indiceStriscia].Color(0, 0, 0);        // Sicurezza
  }
}

// ==========================================
// 🎨 I TUOI DISEGNI
// ==========================================

char disegno0[NUM_STRIPS][NUMPIXELS] = {//tutto nero
  {'N', 'N', 'N', 'N', 'N'}, // Striscia 1 (Pin 3)
  {'N', 'N', 'N', 'N', 'N'}, // Striscia 2 (Pin 4)
  {'N', 'N', 'N', 'N', 'N'}, // Striscia 3 (Pin 5)
  {'N', 'N', 'N', 'N', 'N'}, // Striscia 4 (Pin 6)
  {'N', 'N', 'N', 'N', 'N'}  // Striscia 5 (Pin 7)
};

char disegno1[NUM_STRIPS][NUMPIXELS] = {//solo muri
  {'R', 'N', 'N', 'N', 'N'}, // Striscia 1 (Pin 3)
  {'R', 'N', 'R', 'N', 'R'}, // Striscia 2 (Pin 4)
  {'N', 'N', 'N', 'R', 'N'}, // Striscia 3 (Pin 5)
  {'N', 'R', 'N', 'N', 'N'}, // Striscia 4 (Pin 6)
  {'N', 'N', 'R', 'R', 'N'}  // Striscia 5 (Pin 7)
};

char disegno2[NUM_STRIPS][NUMPIXELS] = {//muri e strada
  {'R', 'W', 'W', 'W', 'W'}, // Striscia 1 (Pin 3)
  {'R', 'W', 'R', 'W', 'R'}, // Striscia 2 (Pin 4)
  {'W', 'W', 'N', 'R', 'W'}, // Striscia 3 (Pin 5)
  {'W', 'R', 'W', 'W', 'W'}, // Striscia 4 (Pin 6)
  {'W', 'W', 'R', 'R', 'W'}  // Striscia 5 (Pin 7)
};

char disegno3[NUM_STRIPS][NUMPIXELS] = {//muri strada e centro
  {'R', 'W', 'W', 'W', 'W'}, // Striscia 1 (Pin 3)
  {'R', 'W', 'R', 'W', 'R'}, // Striscia 2 (Pin 4)
  {'W', 'W', 'B', 'R', 'W'}, // Striscia 3 (Pin 5)
  {'W', 'R', 'W', 'W', 'W'}, // Striscia 4 (Pin 6)
  {'W', 'W', 'R', 'R', 'W'}  // Striscia 5 (Pin 7)
};

char disegno4[NUM_STRIPS][NUMPIXELS] = {//muri strada centro e special
  {'R', 'W', 'W', 'W', 'W'}, // Striscia 1 (Pin 3)
  {'R', 'W', 'R', 'W', 'R'}, // Striscia 2 (Pin 4)
  {'W', 'W', 'B', 'R', 'W'}, // Striscia 3 (Pin 5)
  {'W', 'R', 'W', 'W', 'G'}, // Striscia 4 (Pin 6)
  {'W', 'W', 'R', 'R', 'W'}  // Striscia 5 (Pin 7)
};

char disegno5[NUM_STRIPS][NUMPIXELS] = {//muri strada centro e bonus
  {'R', 'W', 'W', 'W', 'W'}, // Striscia 1 (Pin 3)
  {'R', 'W', 'R', 'W', 'R'}, // Striscia 2 (Pin 4)
  {'W', 'W', 'B', 'R', 'W'}, // Striscia 3 (Pin 5)
